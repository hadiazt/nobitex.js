# Copy to `.env` (never commit it) and load it with `node --env-file=.env`.
# Use an API key pair (recommended; required for bots since Nobitex disabled bot login in
# November 2026) OR a token.

# API key (Ed25519) created in the Nobitex panel (or via `client.apiKeys.create()`)
NOBITEX_API_KEY=
NOBITEX_API_PRIVATE_KEY=

# Token copied from https://nobitex.ir/app/settings/ (only for token-only endpoints)
NOBITEX_TOKEN=

# Optional: "production" (default) or "testnet"
NOBITEX_ENV=production
# Optional: override the REST base URL (e.g. a proxy inside Iran)
NOBITEX_BASE_URL=
